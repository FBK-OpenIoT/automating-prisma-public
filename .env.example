# Copy to .env; choose model IDs supported by your account.
GEMINI_API_KEY=
MODEL=
MODEL_SUPERVISOR=
MODEL_EMBEDDING=
CLAUDE_API_KEY=
MODEL_CLAUDE=
MODEL_SUPERVISOR_CLAUDE=
# Optional private input workspace; paths are relative to the repository root.
# PRISMA_DATA_DIR=local/my-review
# Results default to <PRISMA_DATA_DIR>/results, with gemini/ and claude/ below it.
# PRISMA_RESULTS_DIR=runs/my-experiment
# Optional shared PDF folder (otherwise full_text/<provider> in the data directory).
# PRISMA_PDF_DIR=local/my-review/full_text/shared
# AQA date filters default to true only for the bundled data directory.
# PRISMA_CASE_STUDY_FILTERS=false
